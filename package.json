{
  "name": "udb-aula-sync",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Extensión MV3 para descargar y organizar el material del Aula Digital UDB (Moodle).",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "idb": "8.0.3",
    "preact": "10.29.8",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@crxjs/vite-plugin": "3.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "2.10.6",
    "@resvg/resvg-js": "2.6.2",
    "@types/chrome": "0.3.4",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.5",
    "fflate": "0.8.3",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && pnpm check:manifest",
    "check:manifest": "tsx scripts/check-manifest.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test -c tests/e2e/playwright.config.ts",
    "mock": "tsx tests/mock-moodle/server.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "zip": "pnpm build && tsx scripts/build-zip.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
